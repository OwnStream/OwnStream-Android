<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:baselineAligned="false"
	android:orientation="horizontal"
	tools:context=".ui.fragment.setup.SetupServerSelectFragment">

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1"
		android:gravity="center"
		android:orientation="vertical">

		<TextView
			style="?textAppearanceDisplayMedium"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="@string/setup_server_select_title"
			android:textAlignment="center" />

		<TextView
			style="?textAppearanceBodyLarge"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginVertical="12dp"
			android:maxWidth="500dp"
			android:text="@string/setup_server_select_body"
			android:textAlignment="center"
			android:textSize="24sp" />
	</LinearLayout>

	<dev.kuylar.leanbackm3views.component.TvFocusLinearLayout
		android:id="@+id/server_list"
		android:layout_width="0dp"
		android:layout_height="match_parent"
		android:layout_weight="1"
		android:gravity="center"
		android:orientation="vertical">

		<dev.kuylar.leanbackm3views.component.TvListItem
			android:id="@+id/add_server"
			android:layout_width="400dp"
			android:layout_height="wrap_content"
			android:icon="@drawable/ic_add"
			android:text="@string/setup_server_select_new" />

		<View
			android:id="@+id/divider"
			android:layout_width="400dp"
			android:layout_height="1dp"
			android:layout_marginVertical="8dp"
			android:background="?tvColorBorder" />

	</dev.kuylar.leanbackm3views.component.TvFocusLinearLayout>

</LinearLayout>