<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:gravity="center"
	android:orientation="vertical"
	tools:context=".ui.fragment.setup.SetupWelcomeFragment">

	<TextView
		style="?textAppearanceDisplayMedium"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="@string/setup_welcome_title"
		android:textAlignment="center" />

	<TextView
		style="?textAppearanceBodyLarge"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginVertical="12dp"
		android:maxWidth="500dp"
		android:text="@string/setup_welcome_body"
		android:textAlignment="center"
		android:textSize="24sp" />

	<com.google.android.material.textfield.TextInputLayout
		android:id="@+id/field"
		android:layout_width="300dp"
		android:layout_height="wrap_content"
		android:layout_marginVertical="12dp"
		android:hint="@string/setup_host_label">

		<com.google.android.material.textfield.TextInputEditText
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:hint="@string/setup_host_placeholder" />

	</com.google.android.material.textfield.TextInputLayout>

	<dev.kuylar.leanbackm3views.component.TvButton
		android:id="@+id/submit"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		app:tvButtonStyle="filled"
		android:text="@string/setup_host_submit" />

</LinearLayout>