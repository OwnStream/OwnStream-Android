<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/main"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="horizontal"
	tools:context=".ui.activity.SeasonActivity">

	<ImageView
		android:id="@+id/backdrop"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:scaleType="centerCrop"
		tools:src="@tools:sample/backgrounds/scenic" />

	<View
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:alpha=".95"
		android:foreground="@color/m3_tv_dark_background" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="horizontal"
		android:paddingHorizontal="56dp">

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="2"
			android:gravity="center"
			android:orientation="vertical">

			<ImageView
				android:id="@+id/poster"
				android:layout_width="150dp"
				android:layout_height="225dp"
				android:layout_marginBottom="16dp"
				android:importantForAccessibility="no"
				android:scaleType="centerCrop"
				tools:src="@tools:sample/backgrounds/scenic" />

			<TextView
				android:id="@+id/contentTitle"
				style="?textAppearanceLabelMedium"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				tools:text="Content Title" />

			<TextView
				android:id="@+id/seasonTitle"
				style="?textAppearanceTitleLarge"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				tools:text="Season 1" />

			<TextView
				android:id="@+id/seasonDesc"
				style="?textAppearanceBodyMedium"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:ellipsize="end"
				android:maxLines="6"
				tools:text="@tools:sample/lorem/random" />

		</LinearLayout>

		<Space
			android:layout_width="64dp"
			android:layout_height="wrap_content" />

		<dev.kuylar.leanbackm3views.component.TvRecyclerView
			android:id="@+id/recycler"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="3"
			android:clipToPadding="false"
			android:paddingVertical="54dp"
			android:paddingHorizontal="12dp"
			tools:listitem="@layout/item_card_episode" />

	</LinearLayout>
</FrameLayout>